        "name": "Patient Alert Feed",
        "func": "let alerts = context.get(\"alerts\") || [];\n\nalerts.unshift(msg.payload);\n\n// Keep only the latest 10 alerts\nif (alerts.length > 10) {\n    alerts = alerts.slice(0, 10);\n}\n\ncontext.set(\"alerts\", alerts);\n\nmsg.payload = alerts.join(\"\\n\");\n\nreturn msg;",
