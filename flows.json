        "name": "Patient Data Aggregator",
        "func": "let data = context.get(\"data\") || {\n    heart_rate: [],\n    spo2: [],\n    temperature: []\n};\n\nif (msg.topic.includes(\"heart_rate\")) data.heart_rate.push(Number(msg.payload));\nif (msg.topic.includes(\"spo2\")) data.spo2.push(Number(msg.payload));\nif (msg.topic.includes(\"body_temperature\")) data.temperature.push(Number(msg.payload));\n\nif (msg.topic === \"timer\") {\n    const avg = arr => arr.length ? (arr.reduce((a,b) => a+b, 0) / arr.length).toFixed(1) : \"N/A\";\n\n    msg.topic = \"hospital/summary/patient\";\n    msg.payload = JSON.stringify({\n        heart_rate_avg: avg(data.heart_rate),\n        spo2_avg: avg(data.spo2),\n        temperature_avg: avg(data.temperature)\n    });\n\n    context.set(\"data\", {heart_rate: [], spo2: [], temperature: []});\n    return msg;\n}\n\ncontext.set(\"data\", data);\nreturn null;",
